unmanaged implementation in class zbp_ce_bom_api unique;
strict ( 2 );

define behavior for ZCE_BOM_API alias BomApi
lock master
authorization master ( global )
{
  field ( readonly ) ApiId;

  static action ValidateMaterialPlant
    parameter ZA_BOM_VALIDATE_REQ
    result [1] ZA_BOM_VALIDATE_RES;

  static action GetAlternateBOMItems
    parameter ZA_BOM_ALT_ITEMS_REQ
    result [0..*] ZA_BOM_ALT_ITEMS_RES;

  static action GetNextAltBOM
    parameter ZA_BOM_NEXT_ALT_REQ
    result [1] ZA_BOM_NEXT_ALT_RES;

     static action ChangeBOMItem
    parameter ZABS_BOM_CHANGE_PARAM
    result [1] ZA_BOM_CHANGE_ITEM_RES;
}